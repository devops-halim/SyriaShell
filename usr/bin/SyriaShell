#!/bin/bash

# Modern Color Palette
RESET='\033[0m'
BOLD='\033[1m'
DIM='\033[2m'

# Vibrant Colors
RED='\033[38;5;196m'
BRIGHT_RED='\033[38;5;9m'
GREEN='\033[38;5;46m'
BRIGHT_GREEN='\033[38;5;10m'
CYAN='\033[38;5;51m'
BLUE='\033[38;5;39m'
MAGENTA='\033[38;5;201m'
YELLOW='\033[38;5;226m'
ORANGE='\033[38;5;208m'
WHITE='\033[38;5;231m'
GRAY='\033[38;5;243m'

# Background Colors
BG_RED='\033[48;5;196m'
BG_WHITE='\033[48;5;231m'
BG_BLACK='\033[48;5;232m'
BG_GREEN='\033[48;5;46m'

# Box Drawing Characters
TOP_LEFT='╔'
TOP_RIGHT='╗'
BOTTOM_LEFT='╚'
BOTTOM_RIGHT='╝'
HORIZONTAL='═'
VERTICAL='║'
T_RIGHT='╠'
T_LEFT='╣'

# Icons
ICON_USER='👤'
ICON_STAR='★'
ICON_ROCKET='🚀'
ICON_COMPUTER='💻'
ICON_GEAR='⚙️'
ICON_CLOCK='🕐'
ICON_TERMINAL='⌨️'
ICON_CHIP='🔧'

# Syria Liberation Date
CURRENT_DATE="08.12.2024"

# Welcome Message with Modern Design
welcome_message() {
    local width=60
    local line=$(printf '%*s' "$width" | tr ' ' "${HORIZONTAL}")

    echo
    echo -e "${CYAN}${TOP_LEFT}${line}${TOP_RIGHT}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}                                                            ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}        ${BRIGHT_GREEN}${BOLD}${ICON_ROCKET}  Welcome Back! Have fun :)  ${ICON_ROCKET}${RESET}           ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}                                                            ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}              ${RED}${BOLD}SYRIA FREE  ${ICON_STAR}  ${CURRENT_DATE}${RESET}                ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}                                                            ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${BOTTOM_LEFT}${line}${BOTTOM_RIGHT}${RESET}"
    echo
    sleep 1.5
}

# Syrian Flag with Modern Styling
draw_flag() {
    echo -e "${CYAN}${TOP_LEFT}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${TOP_RIGHT}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}                                                            ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}              ${MAGENTA}${BOLD}${ICON_USER} Abdulhalim ALnasani${RESET}                      ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}              ${BLUE}🌐 www.alnasani.com${RESET}                          ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}                                                            ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${T_RIGHT}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${T_LEFT}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}            ${BG_RED}                                    ${RESET}            ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}            ${BG_WHITE}              ${RED}${ICON_STAR}    ${ICON_STAR}    ${ICON_STAR}${BG_WHITE}              ${RESET}            ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}            ${BG_BLACK}                                    ${RESET}            ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}                                                            ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${T_RIGHT}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${T_LEFT}${RESET}"
}

# System Information with Icons and Modern Layout
add_info() {
    echo -e "${CYAN}${VERTICAL}${RESET}   ${YELLOW}${BOLD}${ICON_COMPUTER}  System Information${RESET}                                  ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}                                                            ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}   ${BRIGHT_GREEN}${ICON_GEAR}  OS:${RESET}       ${WHITE}$(lsb_release -d | cut -f2)${RESET}       ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}   ${BRIGHT_GREEN}${ICON_CHIP}  Kernel:${RESET}   ${WHITE}$(uname -r)${RESET}                                  ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}   ${BRIGHT_GREEN}${ICON_CLOCK}  Uptime:${RESET}   ${WHITE}$(uptime -p)${RESET}                     ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}   ${BRIGHT_GREEN}${ICON_TERMINAL}  Shell:${RESET}    ${WHITE}$SHELL${RESET}                                   ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}   ${BRIGHT_GREEN}💠 Terminal:${RESET} ${WHITE}$TERM${RESET}                                       ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}                                                            ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${BOTTOM_LEFT}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${HORIZONTAL}${BOTTOM_RIGHT}${RESET}"
    echo
}

# Main Execution
welcome_message
draw_flag
add_info