#!/bin/bash

# Hacker/Cyber Color Palette
RESET='\033[0m'
BOLD='\033[1m'
DIM='\033[2m'
BLINK='\033[5m'

# Matrix/Cyber Colors
MATRIX_GREEN='\033[38;5;46m'
DARK_GREEN='\033[38;5;34m'
NEON_GREEN='\033[38;5;82m'
CYBER_RED='\033[38;5;196m'
BLOOD_RED='\033[38;5;160m'
NEON_CYAN='\033[38;5;51m'
ELECTRIC_BLUE='\033[38;5;33m'
DARK_GRAY='\033[38;5;236m'
TERMINAL_GREEN='\033[38;5;40m'
HACKER_YELLOW='\033[38;5;226m'
WHITE='\033[38;5;231m'
BLACK='\033[38;5;232m'

# Flag Colors
FLAG_RED='\033[48;5;196m'
FLAG_GREEN='\033[48;5;28m'
FLAG_BLACK='\033[48;5;232m'
FLAG_WHITE='\033[48;5;231m'
STAR_RED='\033[38;5;196m'

# Cyber ASCII Characters
SKULL='☠'
CROSSHAIR='⊕'
LOCK='🔒'
UNLOCK='🔓'
STAR='★'
LIGHTNING='⚡'
TERMINAL='▶'
SKULL_ICON='💀'
FIRE='🔥'
HACKER='⚠'
ALERT='⚠'

# Syria Liberation Date
CURRENT_DATE="08.12.2024"

# Hacker-Style Welcome Banner
welcome_message() {
    echo
    echo -e "${MATRIX_GREEN}${BOLD}"
    echo -e "    ███████╗██╗   ██╗██████╗ ██╗ █████╗     ███████╗██████╗ ███████╗███████╗"
    echo -e "    ██╔════╝╚██╗ ██╔╝██╔══██╗██║██╔══██╗    ██╔════╝██╔══██╗██╔════╝██╔════╝"
    echo -e "    ███████╗ ╚████╔╝ ██████╔╝██║███████║    █████╗  ██████╔╝█████╗  █████╗  "
    echo -e "    ╚════██║  ╚██╔╝  ██╔══██╗██║██╔══██║    ██╔══╝  ██╔══██╗██╔══╝  ██╔══╝  "
    echo -e "    ███████║   ██║   ██║  ██║██║██║  ██║    ██║     ██║  ██║███████╗███████╗"
    echo -e "    ╚══════╝   ╚═╝   ╚═╝  ╚═╝╚═╝╚═╝  ╚═╝    ╚═╝     ╚═╝  ╚═╝╚══════╝╚══════╝"
    echo -e "${RESET}"
    echo -e "${CYBER_RED}${BOLD}    ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓${RESET}"
    echo -e "${CYBER_RED}${BOLD}    ┃${RESET}  ${FIRE}${BOLD}  LIBERATION DATE: ${CURRENT_DATE}  ${FIRE}                       ${CYBER_RED}${BOLD}┃${RESET}"
    echo -e "${CYBER_RED}${BOLD}    ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛${RESET}"
