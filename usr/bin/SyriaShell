    sleep 0.8
}

# Cyber Syrian Flag
draw_flag() {
    echo -e "${MATRIX_GREEN}${BOLD}    ╔════════════════════════════════════════════════════════════╗${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}  ${NEON_CYAN}${CROSSHAIR}${RESET} ${HACKER_YELLOW}OPERATOR:${RESET} ${WHITE}Abdulhalim ALnasani${RESET}                      ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}  ${NEON_CYAN}${LIGHTNING}${RESET} ${HACKER_YELLOW}WEBSITE:${RESET}  ${ELECTRIC_BLUE}https://www.alnasani.com${RESET}              ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ╠════════════════════════════════════════════════════════════╣${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}                                                            ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}              ${CYBER_RED}${BOLD}[ SYRIAN FLAG - ACTIVE ]${RESET}                 ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}                                                            ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}           ${DARK_GRAY}╔══════════════════════════════╗${RESET}              ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}           ${DARK_GRAY}║${FLAG_GREEN}                              ${RESET}${DARK_GRAY}║${RESET}              ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}           ${DARK_GRAY}║${FLAG_GREEN}                              ${RESET}${DARK_GRAY}║${RESET}              ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}           ${DARK_GRAY}║${FLAG_WHITE}         ${STAR_RED}${BOLD}${STAR}     ${STAR}     ${STAR}${FLAG_WHITE}         ${RESET}${DARK_GRAY}║${RESET}              ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}           ${DARK_GRAY}║${FLAG_WHITE}                              ${RESET}${DARK_GRAY}║${RESET}              ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}           ${DARK_GRAY}║${FLAG_BLACK}                              ${RESET}${DARK_GRAY}║${RESET}              ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}           ${DARK_GRAY}║${FLAG_BLACK}                              ${RESET}${DARK_GRAY}║${RESET}              ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}           ${DARK_GRAY}╚══════════════════════════════╝${RESET}              ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}                                                            ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ╠════════════════════════════════════════════════════════════╣${RESET}"
}

# Hacker-Style System Information
add_info() {
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}                                                            ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}        ${CYBER_RED}${BOLD}[${ALERT}] SYSTEM DIAGNOSTICS ${ALERT}${RESET}                      ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}        ${DARK_GRAY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}             ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}                                                            ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}        ${TERMINAL_GREEN}${TERMINAL}${RESET} ${HACKER_YELLOW}OS:${RESET}        ${NEON_GREEN}$(lsb_release -d | cut -f2)${RESET}  ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}        ${TERMINAL_GREEN}${TERMINAL}${RESET} ${HACKER_YELLOW}KERNEL:${RESET}    ${NEON_GREEN}$(uname -r)${RESET}                         ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}        ${TERMINAL_GREEN}${TERMINAL}${RESET} ${HACKER_YELLOW}UPTIME:${RESET}    ${NEON_GREEN}$(uptime -p)${RESET}            ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}        ${TERMINAL_GREEN}${TERMINAL}${RESET} ${HACKER_YELLOW}SHELL:${RESET}     ${NEON_GREEN}$SHELL${RESET}                          ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}        ${TERMINAL_GREEN}${TERMINAL}${RESET} ${HACKER_YELLOW}TERMINAL:${RESET}  ${NEON_GREEN}$TERM${RESET}                              ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ║${RESET}                                                            ${MATRIX_GREEN}${BOLD}║${RESET}"
    echo -e "${MATRIX_GREEN}${BOLD}    ╚════════════════════════════════════════════════════════════╝${RESET}"
    echo
    echo -e "    ${DARK_GREEN}[${UNLOCK}] ${TERMINAL_GREEN}Access granted by:${RESET} ${NEON_CYAN}Abdulhalim ALnasani${RESET}"
    echo -e "    ${DARK_GREEN}[${FIRE}] ${CYBER_RED}${BOLD}SYRIA FREE - LIBERATION ACTIVATED${RESET}"
    echo
}

# Main Execution
welcome_message
draw_flag
add_info