#!/bin/bash

# Modern Color Palette
RESET='\033[0m'
BOLD='\033[1m'
DIM='\033[2m'

# Vibrant Colors
RED='\033[38;5;196m'
BRIGHT_RED='\033[38;5;9m'
GREEN='\033[38;5;46m'
BRIGHT_GREEN='\033[38;5;10m'
CYAN='\033[38;5;51m'
BLUE='\033[38;5;39m'
MAGENTA='\033[38;5;201m'
YELLOW='\033[38;5;226m'
ORANGE='\033[38;5;208m'
WHITE='\033[38;5;231m'
GRAY='\033[38;5;243m'
PURPLE='\033[38;5;165m'
PINK='\033[38;5;205m'

# Flag Colors
FLAG_RED='\033[48;5;196m'
FLAG_GREEN='\033[48;5;28m'
FLAG_BLACK='\033[48;5;232m'
FLAG_WHITE='\033[48;5;231m'
STAR_RED='\033[38;5;196m'

# Box Drawing Characters
TOP_LEFT='╔'
TOP_RIGHT='╗'
BOTTOM_LEFT='╚'
BOTTOM_RIGHT='╝'
HORIZONTAL='═'
VERTICAL='║'
T_RIGHT='╠'
T_LEFT='╣'
DOUBLE_HORIZONTAL='─'
HEAVY_HORIZONTAL='━'

# Icons
ICON_USER='👤'
ICON_STAR='★'
ICON_ROCKET='🚀'
ICON_COMPUTER='💻'
ICON_GEAR='⚙️'
ICON_CLOCK='🕐'
ICON_TERMINAL='⌨️'
ICON_CHIP='🔧'
ICON_GLOBE='🌐'
ICON_FLAG='🏴'
ICON_HEART='❤️'

# Syria Liberation Date
CURRENT_DATE="08.12.2024"

# Welcome Message with Modern Design
welcome_message() {
    local width=60
    local line=$(printf '%*s' "$width" | tr ' ' "${HORIZONTAL}")

    echo
    echo -e "${MAGENTA}${TOP_LEFT}${line}${TOP_RIGHT}${RESET}"
    echo -e "${MAGENTA}${VERTICAL}${RESET}                                                            ${MAGENTA}${VERTICAL}${RESET}"
    echo -e "${MAGENTA}${VERTICAL}${RESET}       ${BRIGHT_GREEN}${BOLD}${ICON_ROCKET}  Welcome Back! Have fun :)  ${ICON_ROCKET}${RESET}           ${MAGENTA}${VERTICAL}${RESET}"
    echo -e "${MAGENTA}${VERTICAL}${RESET}                                                            ${MAGENTA}${VERTICAL}${RESET}"
    echo -e "${MAGENTA}${VERTICAL}${RESET}             ${RED}${BOLD}${ICON_FLAG}  SYRIA FREE  ${ICON_STAR}  ${CURRENT_DATE}  ${ICON_FLAG}${RESET}          ${MAGENTA}${VERTICAL}${RESET}"
    echo -e "${MAGENTA}${VERTICAL}${RESET}                                                            ${MAGENTA}${VERTICAL}${RESET}"
    echo -e "${MAGENTA}${BOTTOM_LEFT}${line}${BOTTOM_RIGHT}${RESET}"
    echo
    sleep 1.2
}

# Syrian Flag with Modern Styling
draw_flag() {
    local width=60
    local line=$(printf '%*s' "$width" | tr ' ' "${HORIZONTAL}")

    echo -e "${CYAN}${TOP_LEFT}${line}${TOP_RIGHT}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}                                                            ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}           ${PINK}${BOLD}${ICON_USER}  Abdulhalim ALnasani${RESET}                       ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}           ${BLUE}${BOLD}${ICON_GLOBE}  https://www.alnasani.com${RESET}                  ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}                                                            ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${T_RIGHT}${line}${T_LEFT}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}                                                            ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}                   ${GRAY}${BOLD}Syrian Flag${RESET}                         ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}         ${GRAY}┌────────────────────────────┐${RESET}                ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}         ${GRAY}│${FLAG_GREEN}                            ${RESET}${GRAY}│${RESET}                ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}         ${GRAY}│${FLAG_GREEN}                            ${RESET}${GRAY}│${RESET}                ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}         ${GRAY}│${FLAG_WHITE}       ${STAR_RED}${BOLD}${ICON_STAR}     ${ICON_STAR}     ${ICON_STAR}${FLAG_WHITE}       ${RESET}${GRAY}│${RESET}                ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}         ${GRAY}│${FLAG_WHITE}                            ${RESET}${GRAY}│${RESET}                ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}         ${GRAY}│${FLAG_BLACK}                            ${RESET}${GRAY}│${RESET}                ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}         ${GRAY}│${FLAG_BLACK}                            ${RESET}${GRAY}│${RESET}                ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}         ${GRAY}└────────────────────────────┘${RESET}                ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}                                                            ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${T_RIGHT}${line}${T_LEFT}${RESET}"
}

# System Information with Icons and Modern Layout
add_info() {
    local width=60
    local line=$(printf '%*s' "$width" | tr ' ' "${HORIZONTAL}")

    echo -e "${CYAN}${VERTICAL}${RESET}                                                            ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}        ${YELLOW}${BOLD}${ICON_COMPUTER}  System Information${RESET}                           ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}        ${GRAY}${DOUBLE_HORIZONTAL}${DOUBLE_HORIZONTAL}${DOUBLE_HORIZONTAL}${DOUBLE_HORIZONTAL}${DOUBLE_HORIZONTAL}${DOUBLE_HORIZONTAL}${DOUBLE_HORIZONTAL}${DOUBLE_HORIZONTAL}${DOUBLE_HORIZONTAL}${DOUBLE_HORIZONTAL}${DOUBLE_HORIZONTAL}${DOUBLE_HORIZONTAL}${DOUBLE_HORIZONTAL}${DOUBLE_HORIZONTAL}${DOUBLE_HORIZONTAL}${DOUBLE_HORIZONTAL}${DOUBLE_HORIZONTAL}${DOUBLE_HORIZONTAL}${DOUBLE_HORIZONTAL}${DOUBLE_HORIZONTAL}${DOUBLE_HORIZONTAL}${DOUBLE_HORIZONTAL}${RESET}                         ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}                                                            ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}        ${BRIGHT_GREEN}${ICON_GEAR}${RESET}  ${ORANGE}OS:${RESET}        ${WHITE}$(lsb_release -d | cut -f2)${RESET}  ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}        ${BRIGHT_GREEN}${ICON_CHIP}${RESET}  ${ORANGE}Kernel:${RESET}    ${WHITE}$(uname -r)${RESET}                         ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}        ${BRIGHT_GREEN}${ICON_CLOCK}${RESET}  ${ORANGE}Uptime:${RESET}    ${WHITE}$(uptime -p)${RESET}            ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}        ${BRIGHT_GREEN}${ICON_TERMINAL}${RESET}  ${ORANGE}Shell:${RESET}     ${WHITE}$SHELL${RESET}                          ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}        ${BRIGHT_GREEN}💠${RESET}  ${ORANGE}Terminal:${RESET}  ${WHITE}$TERM${RESET}                              ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${VERTICAL}${RESET}                                                            ${CYAN}${VERTICAL}${RESET}"
    echo -e "${CYAN}${BOTTOM_LEFT}${line}${BOTTOM_RIGHT}${RESET}"
    echo
    echo -e "        ${GRAY}Made with ${ICON_HEART}  by Abdulhalim ALnasani${RESET}"
    echo
}

# Main Execution
welcome_message
draw_flag
add_info