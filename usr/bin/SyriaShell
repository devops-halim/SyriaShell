    echo -e "${TERMINAL_GREEN}${TERMINAL}${RESET} ${NEON_GREEN}SYSTEM ACCESS GRANTED...${RESET}"
    echo -e "${TERMINAL_GREEN}${TERMINAL}${RESET} ${NEON_GREEN}Initializing SyriaShell...${RESET}"
